---
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 // Signal Lost | tRizyal</title>
    <link rel="icon" type="image/png" href="/triz_logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-obsidian text-white min-h-screen overflow-hidden relative select-none">
    <!-- Animated Glitch Background Canvas -->
    <canvas id="glitch-canvas" class="fixed inset-0 w-full h-full z-0"></canvas>

    <!-- Subtle CRT Scanlines -->
    <div class="crt-scanlines fixed inset-0 pointer-events-none z-10"></div>

    <!-- Foreground Content -->
    <main class="relative z-20 min-h-screen flex flex-col items-center justify-center px-6 text-center">
      <div class="glitch-stack space-y-3 sm:space-y-5" id="glitch-title">
        <h1 class="glitch-text" data-text="ERROR">
          ERROR
        </h1>
        <h1 class="glitch-text" data-text="404">
          404
        </h1>
      </div>

      <p class="mt-8 font-mono text-xs sm:text-sm tracking-[0.2em] uppercase text-cyan-300 bg-obsidian/90 px-4 py-2 border border-pink-400/50 shadow-[0_0_20px_rgba(244,114,182,0.25)]">
        // GAME OVER — ROUTE NOT FOUND
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="retro-btn font-mono text-xs sm:text-sm uppercase tracking-widest px-6 py-3 bg-obsidian/90 text-white border-2 border-cyan-400 hover:bg-cyan-400 hover:text-obsidian transition-all duration-150"
        >
          ▶ Continue (Home)
        </a>
        <button
          type="button"
          onclick="history.back()"
          class="font-mono text-xs sm:text-sm uppercase tracking-widest px-6 py-3 bg-obsidian/90 text-pink-400 border-2 border-pink-400/70 hover:bg-pink-400 hover:text-obsidian transition-all duration-150 cursor-pointer"
        >
          ← Go Back
        </button>
      </div>
    </main>
  </body>
</html>

<style>
  .glitch-text {
    font-family: "Press Start 2P", monospace;
    font-size: clamp(2.75rem, 11vw, 7.5rem);
    line-height: 1.1;
    color: #f8fafc;
    position: relative;
    letter-spacing: 0.06em;
    text-shadow:
      -4px -3px 0 #22d3ee,
      4px 3px 0 #f472b6,
      0 0 24px rgba(56, 189, 248, 0.4);
    animation: text-jitter 3.2s infinite steps(1);
  }

  .glitch-text::before,
  .glitch-text::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Hero Cyan chromatic slice */
  .glitch-text::before {
    color: #22d3ee;
    transform: translate(-5px, -2px);
    clip-path: inset(0 0 65% 0);
    animation: slice-top 2.1s infinite linear alternate-reverse;
  }

  /* Hero Pink chromatic slice */
  .glitch-text::after {
    color: #f472b6;
    transform: translate(5px, 2px);
    clip-path: inset(60% 0 0 0);
    animation: slice-bottom 1.7s infinite linear alternate-reverse;
  }

  /* Heavy VHS tear burst */
  .glitch-stack.burst .glitch-text {
    transform: skewX(-12deg) translateX(6px);
    text-shadow:
      -10px 0 0 #22d3ee,
      10px 0 0 #ec4899;
  }

  .retro-btn {
    box-shadow:
      -3px 0 0 #f472b6,
      3px 0 0 #22d3ee,
      0 0 18px rgba(56, 189, 248, 0.35);
  }

  .crt-scanlines {
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0px,
      rgba(0, 0, 0, 0) 2px,
      rgba(0, 0, 0, 0.22) 3px,
      rgba(0, 0, 0, 0.22) 4px
    );
  }

  @keyframes slice-top {
    0% {
      clip-path: inset(8% 0 78% 0);
      transform: translate(-6px, -2px);
    }
    20% {
      clip-path: inset(42% 0 40% 0);
      transform: translate(5px, 0);
    }
    40% {
      clip-path: inset(15% 0 68% 0);
      transform: translate(-4px, 1px);
    }
    60% {
      clip-path: inset(65% 0 15% 0);
      transform: translate(7px, -1px);
    }
    80% {
      clip-path: inset(25% 0 55% 0);
      transform: translate(-7px, 2px);
    }
    100% {
      clip-path: inset(5% 0 82% 0);
      transform: translate(-3px, -2px);
    }
  }

  @keyframes slice-bottom {
    0% {
      clip-path: inset(72% 0 8% 0);
      transform: translate(6px, 2px);
    }
    25% {
      clip-path: inset(30% 0 50% 0);
      transform: translate(-6px, 0);
    }
    50% {
      clip-path: inset(80% 0 4% 0);
      transform: translate(8px, -1px);
    }
    75% {
      clip-path: inset(48% 0 32% 0);
      transform: translate(-5px, 2px);
    }
    100% {
      clip-path: inset(62% 0 18% 0);
      transform: translate(4px, 1px);
    }
  }

  @keyframes text-jitter {
    0%,
    92%,
    100% {
      transform: translate(0, 0);
    }
    93% {
      transform: translate(-4px, 2px);
    }
    95% {
      transform: translate(5px, -2px);
    }
    97% {
      transform: translate(-2px, -1px);
    }
  }
</style>

<script>
  const canvas = document.getElementById(
    "glitch-canvas"
  ) as HTMLCanvasElement | null;
  const titleEl = document.getElementById("glitch-title");

  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    // Matched to Hero.astro & global.css: cyan-400, cyan-glow, accent, pink-400, pink-500, slate-50
    const PALETTE = [
      "#22d3ee",
      "#38bdf8",
      "#3b9cba",
      "#f472b6",
      "#ec4899",
      "#f8fafc",
    ];

    let width = 0;
    let height = 0;

    interface StripedBand {
      x: number;
      y: number;
      h: number;
      speed: number;
      stripes: { w: number; color: string }[];
    }

    interface DashLine {
      x: number;
      y: number;
      w: number;
      h: number;
      color: string;
      speed: number;
    }

    let bands: StripedBand[] = [];
    let dashes: DashLine[] = [];

    function rand(min: number, max: number) {
      return Math.random() * (max - min) + min;
    }

    function pick<T>(arr: T[]): T {
      return arr[Math.floor(Math.random() * arr.length)];
    }

    function generateScene() {
      bands = [];
      dashes = [];

      const bandCount = Math.max(14, Math.floor(height / 55));
      for (let i = 0; i < bandCount; i++) {
        const stripeCount = Math.floor(rand(6, 22));
        const stripes = Array.from({ length: stripeCount }, () => ({
          w: rand(4, 28),
          color: Math.random() < 0.2 ? "transparent" : pick(PALETTE),
        }));
        bands.push({
          x: rand(-120, width),
          y: rand(0, height),
          h: pick([10, 14, 22, 34]),
          speed: (Math.random() < 0.5 ? -1 : 1) * rand(0.15, 0.9),
          stripes,
        });
      }

      const dashCount = Math.max(55, Math.floor((width * height) / 16000));
      for (let i = 0; i < dashCount; i++) {
        dashes.push({
          x: rand(0, width),
          y: rand(0, height),
          w: Math.random() < 0.2 ? rand(90, 260) : rand(8, 36),
          h: pick([3, 4, 6]),
          color: pick(PALETTE),
          speed: (Math.random() < 0.5 ? -1 : 1) * rand(0.3, 1.8),
        });
      }
    }

    function resize() {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      generateScene();
    }

    window.addEventListener("resize", resize);
    resize();

    let frame = 0;

    function draw() {
      frame++;

      // Obsidian backdrop (#090b10)
      ctx.fillStyle = "#090b10";
      ctx.fillRect(0, 0, width, height);

      for (const band of bands) {
        band.x += band.speed;
        const totalW = band.stripes.reduce((sum, s) => sum + s.w, 0);

        if (band.x > width + 60) band.x = -totalW - 40;
        if (band.x + totalW < -60) band.x = width + 40;

        const jitterX = Math.random() < 0.025 ? rand(-18, 18) : 0;

        let cursorX = band.x + jitterX;
        for (const s of band.stripes) {
          if (s.color !== "transparent") {
            ctx.fillStyle = s.color;
            ctx.fillRect(
              Math.round(cursorX),
              Math.round(band.y),
              Math.ceil(s.w),
              band.h
            );
          }
          cursorX += s.w;
        }
      }

      for (const d of dashes) {
        d.x += d.speed;
        if (d.x > width + 20) d.x = -d.w - 10;
        if (d.x + d.w < -20) d.x = width + 10;

        ctx.fillStyle = d.color;
        ctx.fillRect(Math.round(d.x), Math.round(d.y), d.w, d.h);
      }

      if (frame % 140 === 0 || Math.random() < 0.008) {
        const flashY = rand(0, height);
        const flashH = rand(4, 26);
        ctx.fillStyle =
          Math.random() < 0.5
            ? "rgba(34, 211, 238, 0.2)"
            : "rgba(244, 114, 182, 0.2)";
        ctx.fillRect(0, flashY, width, flashH);

        if (titleEl && Math.random() < 0.45) {
          titleEl.classList.add("burst");
          setTimeout(() => titleEl.classList.remove("burst"), 120);
        }
      }

      requestAnimationFrame(draw);
    }

    draw();
  }
</script>

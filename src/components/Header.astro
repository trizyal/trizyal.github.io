<script>
  // 1. Theme Toggle Logic
  const toggleBtn = document.getElementById("theme-toggle");
  if (toggleBtn) {
    toggleBtn.addEventListener("click", () => {
      document.documentElement.classList.toggle("dark");
      if (document.documentElement.classList.contains("dark")) {
        localStorage.theme = "dark";
      } else {
        localStorage.theme = "light";
      }
    });
  }

  // 2. Scroll Spy Logic for Dynamic Nav Highlighting
  // Wait for the DOM to load before setting up the observer
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id], footer[id]");
    const navLinks = document.querySelectorAll(".nav-link");

    // The observer watches as sections enter/leave the screen
    const observerOptions = {
      root: null,
      // Triggers when the section reaches the top 30% of the screen
      rootMargin: "-20% 0px -70% 0px",
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const currentId = entry.target.id;

          navLinks.forEach((link) => {
            const glow = link.querySelector(".nav-glow");

            if (link.getAttribute("href") === `#${currentId}`) {
              // Apply ACTIVE state classes
              link.classList.add(
                "bg-slate-200/80",
                "dark:bg-white/10",
                "text-slate-900",
                "dark:text-white"
              );
              link.classList.remove("text-slate-500", "dark:text-slate-400");
              if (glow) glow.classList.remove("opacity-0");
            } else {
              // Apply INACTIVE state classes
              link.classList.remove(
                "bg-slate-200/80",
                "dark:bg-white/10",
                "text-slate-900",
                "dark:text-white"
              );
              link.classList.add("text-slate-500", "dark:text-slate-400");
              if (glow) glow.classList.add("opacity-0");
            }
          });
        }
      });
    }, observerOptions);

    // Tell the observer to watch every section on the page
    sections.forEach((section) => observer.observe(section));
  });
</script>
